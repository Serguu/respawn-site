# Supabase -> Project Settings -> Database -> Connection string (URI).
# Use the "Transaction pooler" string (port 6543) and put your DB password in it.
DATABASE_URL="postgresql://postgres.xxxxx:YOUR-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"

# Supabase -> Project Settings -> API
SUPABASE_URL="https://xxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="service-role-key (server only, never expose)"

# Random string, at least 32 characters. Used to encrypt the editor session cookie
# and to anonymise visitor hashes for view counting.
SESSION_SECRET="change-me-to-a-long-random-string-of-32-plus-chars"
